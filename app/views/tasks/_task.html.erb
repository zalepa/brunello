<div id="<%= dom_id task %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= task.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Scheduled on:</strong>
    <%= task.scheduled_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Block:</strong>
    <%= task.block.name %>
  </div>

  <div>
    <strong class="block font-medium mb-1">Completion status:</strong>
    <%= task.completed %>
  </div>
</div>
