<div class="flex flex-row gap-3">
  <%= link_to task_path(task, task: { completed: !task.completed? }), method: :patch, data: { turbo_method: :patch, turbo_action: :advance }, class: "text-coal" do %>
    <% if task.completed? %>
      <span class="text-brunello-plant font-semibold">DONE</span>
    <% else %>
      <span class="text-brunello-rust font-semibold">TODO</span>
    <% end %>
  <% end %>
  <span class="text-brunello-coal"><%= task.description %></span>
  <%= link_to "(edit)", [:edit, task], class: 'text-sm' %>       
  <%= link_to "(view)", task, class: 'text-sm' %>
</div>