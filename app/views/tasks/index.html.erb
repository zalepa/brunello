<% content_for :title, "Tasks" %>

<div class="w-full">
  
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Tasks</h1>
    <%= link_to "New task", new_task_path, class: "rounded-md px-3.5 py-2.5 bg-brunello-plant text-brunello-plant-dark block font-medium" %>
  </div>

  <div id="tasks" class="min-w-full my-8">
    <% if @tasks.any? %>
      <% @tasks.each do |task| %>
        <%= render task %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No tasks found.</p>
    <% end %>
  </div>
</div>
