<% content_for :title, "Tasks" %>

<div class="w-full">
  
  <div class="flex justify-between items-center">
    <h1 class="text-2xl">Tasks</h1>
    <%= link_to "+ New", new_task_path, class: "rounded-md px-3.5 py-2.5 bg-brunello-plant text-brunello-plant-dark block font-medium" %>
  </div>

  <div id="tasks" class="min-w-3/4 my-8">
    <% if @tasks.any? %>
      <% @tasks.each do |task| %>
        <div class="flex flex-row gap-3">
        <%= link_to task_path(task, task: { completed: !task.completed? }), method: :patch, data: { turbo_method: :patch, turbo_action: :advance }, class: "text-coal" do %>
          <%= render "components/task_status_label", completed: task.completed? %>
        <% end %>
        <span class="text-brunello-coal font-bold"><%= task.scheduled_on %></span>
        <%= link_to "(edit)", [:edit, task], class: 'text-sm' %>       
        <%= link_to "(view)", task, class: 'text-sm' %>
        <%= link_to "(del)", task, method: :delete, class: 'text-sm text-red-600', data: { turbo_method: :delete, turbo_confirm: 'Are you sure?'} %>
        <span class="w-96 lg:w-3/4 text-brunello-coal truncate"><%= task.description %></span>
      </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No tasks found.</p>
    <% end %>
  </div>
</div>
