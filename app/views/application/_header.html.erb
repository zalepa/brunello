<header class="container px-1 py-3 mx-auto mb-6 border border-brunello-plant border-t-0 bg-brunello-seafoam">
  <nav class="flex justify-between items-center uppercase font-bold">
    <div class="flex items-center space-x-4">
      <a href="/" class=" text-brunello-seaform-dark px-3 text-lg">Brunello</a>
      <% if user_signed_in? %>
        <%= link_to "Home", day_path(Date.today), class: "text-brunello-coal hover:underline hover:underline-offset-4" %>
        <%= link_to "All Tasks", tasks_path, class: "text-brunello-coal hover:underline hover:underline-offset-4" %>
      <% else %>
        <%= link_to "Home", root_path, class: "text-brunello-coal hover:underline hover:underline-offset-4" %>
      <% end %>

    </div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-brunello-coal uppercase px-3" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-brunello-coal uppercase px-3" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "text-brunello-coal uppercase px-3" %>
      <% end %>
    </div>
  </nav>
</header>