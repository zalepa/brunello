<header class="bg-white shadow">
  <nav class="container mx-auto px-5 flex justify-between items-center h-16">
    <div class="flex items-center space-x-4">
      <a href="/" class="text-xl font-bold text-gray-900">Brunello</a>
      <% if user_signed_in? %>
      <%= link_to "Home", day_path(Date.today), class: "text-blue-600 hover:text-blue-800" %>
      <% else %>
      <%= link_to "Home", root_path, class: "text-blue-600 hover:text-blue-800" %>
      <% end %>
      <%= link_to "Tasks", tasks_path, class: "text-blue-600 hover:text-blue-800" %>
    </div>
    <div class="flex items-center space-x-4">
      <% if user_signed_in? %>
        <span class="text-gray-700">Welcome, <%= current_user.email %>!</span>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-blue-600 hover:text-blue-800" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-blue-600 hover:text-blue-800" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "text-blue-600 hover:text-blue-800" %>
      <% end %>
    </div>
  </nav>
</header>