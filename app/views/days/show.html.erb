<%# navigation %>
<div class="flex justify-between items-center mb-6 text-sm border-b border-b-coal pb-2">
  <div class="text-left">
    <%= link_to day_path(@day - 1), class: "text-brunello-coal hover:text-gray-800 flex items-center" do %>
      <span class="">&lt;</span>
      <div class="flex flex-row gap-1 ml-3 text-center font-bold">
        <span class="uppercase"><%= (@day - 1).strftime("%b").upcase %></span>
        <span><%= (@day - 1).day %></span>
      </div>
    <% end %>
  </div>
  <div class="text-center">
    <span class="font-bold uppercase"><%= @day.strftime("%A, %B %d") %></span>
  </div>
  <div class="text-right">
    <%= link_to day_path(@day + 1), class: "text-brunello-coal hover:text-gray-800 flex items-center" do %>
      <div class="flex flex-row gap-1 mr-3 text-center font-bold">
        <span class="uppercase"><%= (@day - 1).strftime("%b").upcase %></span>
        <span><%= (@day + 1).day %></span>
      </div>
      <span class="">&gt;</span>
    <% end %>
  </div>
</div>

<%# blocks %>
<div class="flex flex-col lg:flex-row">
  <% @blocks.each do |b| %>
    <div class="container mx-auto p-6">    
      <div class="flex justify-between items-center mb-4">
        <h1 class="text-center uppercase tracking-wider font-extralight flex-1">
          <%= b[:name] %>
        </h1>
        <%= link_to "+", new_task_path(scheduled_on: @day, block_id: b[:block_id]), class: "inline-block text-xl font-bold hover:animate-spin" %>
      </div>
      <% b[:tasks].each do |task| %>
        <%= render task %>
      <% end %>
      
    </div>
  <% end %>
</div>



