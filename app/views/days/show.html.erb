<%# navigation %>
<div class="flex justify-between items-center mb-6 text-sm border-b border-b-coal pb-2">
  <div class="text-left">
    <%= link_to day_path(@day - 1), class: "  hover:text-gray-800 flex items-center" do %>
      <span class="">&lt;</span>
      <div class="flex flex-row gap-1 ml-3 text-center font-bold">
        <span class="uppercase"><%= (@day - 1).strftime("%b").upcase %></span>
        <span><%= (@day - 1).day %></span>
      </div>
    <% end %>
  </div>
  <div class="text-center">
    <span class="font-bold"><%= @day.strftime("%B %d").upcase %></span>
  </div>
  <div class="text-right">
    <%= link_to day_path(@day + 1), class: "  hover:text-gray-800 flex items-center" do %>
      <div class="flex flex-row gap-1 mr-3 text-center font-bold">
        <span class="uppercase"><%= (@day - 1).strftime("%b").upcase %></span>
        <span><%= (@day - 1).day %></span>
      </div>
      <span class="">&gt;</span>
    <% end %>
  </div>
</div>

<%# blocks %>
<div class="flex flex-col lg:flex-row">
  <% @blocks.each do |b| %>
    <div class="container mx-auto p-6">    
      <h1 class="text-center uppercase tracking-wider font-extralight mb-4 border-b border-b-coal"><%= b[:name] %></h1>
      <% b[:tasks].each do |task| %>
        <div class="flex flex-row gap-3">
          <%= link_to task_path(task, task: { completed: !task.completed? }), method: :patch, data: { turbo_method: :patch, turbo_action: :advance }, class: "text-coal" do %>
            <% if task.completed? %>
              <span class="text-green-600 font-semibold">DONE</span>
            <% else %>
              <span class="text-red-600 font-semibold">TODO</span>
            <% end %>
          <% end %>
          <%= link_to task.description, task, class: "text-coal" %>       
        </div>
      <% end %>
      
      <%# buttons %>
      <div class="text-center mt-6">
        <%= link_to new_task_path(scheduled_on: @day, block_id: b[:block_id]), class: "inline-block bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700" do %>
          Create New <%= b[:name] %> Task
        <% end %>
      </div>
    </div>
  <% end %>
</div>

