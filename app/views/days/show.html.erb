<div class="flex justify-between items-center mb-6">
  <div class="text-left">
    <%= link_to day_path(@day - 1), class: "block text-gray-600 hover:text-gray-800 flex items-center" do %>
      <span class="mr-2">&lt;</span>
      <div>
        <span class="text-sm uppercase"><%= (@day - 1).strftime("%b").upcase %></span><br>
        <span class="text-2xl font-bold"><%= (@day - 1).day %></span>
      </div>
    <% end %>
  </div>
  <div class="text-center">
    <span class="text-2xl font-bold"><%= @day.strftime("%B %d").upcase %></span>
  </div>
  <div class="text-right">
    <%= link_to day_path(@day + 1), class: "block text-gray-600 hover:text-gray-800 flex items-center justify-end" do %>
      <div>
        <span class="text-sm uppercase"><%= (@day + 1).strftime("%b").upcase %></span><br>
        <span class="text-2xl font-bold"><%= (@day + 1).day %></span>
      </div>
      <span class="ml-2">&gt;</span>
    <% end %>
  </div>
</div>

<% @blocks.each do |b| %>
  <div class="container mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4"><%= b[:name] %></h1>
   <div class="bg-white shadow-md rounded-lg overflow-hidden">
      <table class="min-w-full table-auto">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-6 py-3 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">Description</th>
            <th class="px-6 py-3 text-left text-sm font-medium text-gray-600 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% b[:tasks].each do |task| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-800"><%= link_to task.description, task, class: "text-blue-600 hover:text-blue-800" %></td>
              <td class="px-6 py-4 text-sm text-gray-800">
                <% if task.completed? %>
                  <span class="text-green-600 font-semibold">Completed</span>
                <% else %>
                  <span class="text-red-600 font-semibold">Pending</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="text-center mt-6">
  <%= link_to new_task_path(scheduled_on: @day), class: "inline-block bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700" do %>
    Create New Task
  <% end %>
</div>